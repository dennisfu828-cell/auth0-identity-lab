# Copy to .env and fill in. None of these values are secrets,
# but .env is gitignored so local config never lands in the repo.

# Tenant domain, WITHOUT https:// (e.g. your-tenant.eu.auth0.com)
AUTH0_DOMAIN=your-tenant.eu.auth0.com

# The Identifier you gave the API in Auth0 (Applications > APIs)
AUTH0_AUDIENCE=https://api.identity-lab.dev

# Where the React app runs (used for CORS)
CLIENT_ORIGIN=http://localhost:5173

PORT=3001
