# Copy to .env.local and fill in.
# Vite only exposes variables prefixed with VITE_ to the browser,
# and EVERYTHING here ends up in the shipped JavaScript bundle.
# That is fine: a SPA is a public client and holds no secrets.
# Never add a client secret here.

# Auth0 > Applications > (your SPA) > Settings > Domain  (no https://)
VITE_AUTH0_DOMAIN=your-tenant.eu.auth0.com

# Auth0 > Applications > (your SPA) > Settings > Client ID
VITE_AUTH0_CLIENT_ID=your-client-id

# Auth0 > Applications > APIs > (your API) > Identifier
VITE_AUTH0_AUDIENCE=https://api.identity-lab.dev

# The Express API
VITE_API_URL=http://localhost:3001
